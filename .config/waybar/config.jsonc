// Monstertov - https://tov.monster/
// monstertov glass: waybar
{
    "layer": "top",
    "position": "top",
    "height": 36,
    "margin-top": 8,
    "margin-left": 12,
    "margin-right": 12,
    "spacing": 6,
    "modules-left": [
        "custom/launcher",
        "hyprland/workspaces",
        "hyprland/window",
        "group/window-controls"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "mpris",
        "privacy",
        "custom/weather",
        "tray",
        "pulseaudio",
        "bluetooth",
        "network",
        "battery",
        "custom/notifications",
        "custom/power"
    ],
    "custom/launcher": {
        "format": "󰣇",
        "tooltip-format": "apps",
        "on-click": "pkill rofi || rofi -show drun"
    },
    "group/window-controls": {
        "orientation": "horizontal",
        "modules": [
            "custom/win-float",
            "custom/win-full",
            "custom/win-close"
        ]
    },
    "custom/win-float": {
        "format": "󰖲",
        "tooltip-format": "float / tile",
        "on-click": "hyprctl dispatch 'hl.dsp.window.float({ action = \"toggle\" })'"
    },
    "custom/win-full": {
        "format": "󰊓",
        "tooltip-format": "fullscreen",
        "on-click": "hyprctl dispatch 'hl.dsp.window.fullscreen()'"
    },
    "custom/win-close": {
        "format": "󰅖",
        "tooltip-format": "close window",
        "on-click": "hyprctl dispatch 'hl.dsp.window.close()'"
    },
    "custom/power": {
        "format": "󰐥",
        "tooltip-format": "power",
        "on-click": "pkill rofi || ~/.config/rofi/powermenu.sh"
    },
    "hyprland/workspaces": {
        "format": "{id}",
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({workspace = \"e-1\"})'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({workspace = \"e+1\"})'"
    },
    "hyprland/window": {
        "max-length": 50,
        "separate-outputs": true
    },
    "clock": {
        "format": "{:%H:%M}",
        "format-alt": "{:%a %d %b  %H:%M}",
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "format": {
                "today": "<span color='#65b9f0'><b>{}</b></span>"
            }
        }
    },
    "mpris": {
        "format": "{status_icon} {dynamic}",
        "format-paused": "{status_icon} <i>{dynamic}</i>",
        "dynamic-order": ["artist", "title"],
        "dynamic-len": 35,
        "status-icons": {
            "playing": "󰐊",
            "paused": "󰏤"
        }
    },
    "privacy": {
        "icon-size": 14,
        "modules": [
            { "type": "screenshare", "tooltip": true },
            { "type": "audio-in", "tooltip": true }
        ]
    },
    "custom/weather": {
        "format": "󰖐 {}",
        "exec": "curl -sf --max-time 10 'https://wttr.in/?format=%t|%C' | jq -Rc 'split(\"|\") | {text: .[0], tooltip: .[1]}'",
        "return-type": "json",
        "interval": 1800,
        "on-click": "kitty --hold sh -c 'curl -s https://wttr.in'"
    },
    "tray": {
        "spacing": 8
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰖁 muted",
        "format-icons": {
            "headphone": "󰋋",
            "default": [
                "󰕿",
                "󰖀",
                "󰕾"
            ]
        },
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },
    "bluetooth": {
        "format": "󰂯",
        "format-disabled": "󰂲",
        "format-connected": "󰂱 {num_connections}",
        "tooltip-format-connected": "{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "format-off": "󰂲"
    },
    "network": {
        "format-wifi": "{icon} {signalStrength}%",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰤮",
        "tooltip-format-wifi": "{essid} ({ipaddr})",
        "on-click": "pkill rofi || ~/.config/rofi/wifi.sh",
        "on-click-right": "nm-connection-editor",
        "format-icons": [
            "󰤟",
            "󰤢",
            "󰤥",
            "󰤨"
        ]
    },
    "battery": {
        "states": {
            "warning": 25,
            "critical": 12
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-icons": [
            "󰁺",
            "󰁼",
            "󰁾",
            "󰂀",
            "󰁹"
        ]
    },
    "custom/notifications": {
        "tooltip": false,
        "format": "{icon}",
        "format-icons": {
            "notification": "󰂚",
            "none": "󰂜",
            "dnd-notification": "󰂛",
            "dnd-none": "󰂛"
        },
        "return-type": "json",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    }
}
